# LinguaNova .gitattributes
# Normalize line endings: commit LF, checkout per platform
* text=auto

# Shell scripts must always use LF
*.sh text eol=lf
build/linux/AppRun text eol=lf
build/linux/*.desktop text eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
# Inno Setup installer sources keep CRLF (Windows tool, files checked by SHA-256)
*.iss text eol=crlf
*.isl text eol=crlf
installer/languages/INNO_SETUP_LICENSE.txt text eol=crlf
