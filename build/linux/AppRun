#!/bin/bash
# AppRun — LinguaNova AppImage entry point
# This script is executed when the AppImage is launched.

set -e

# Resolve the AppImage root directory
APPDIR="$(dirname "$(readlink -f "$0")")"

# Set Qt environment variables for proper rendering
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"

# Software rendering fallback support
if [ "${LINGUANOVA_QT_RENDER_MODE}" = "software" ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export QT_QUICK_BACKEND=software
fi

# Ensure bundled libraries take precedence
export LD_LIBRARY_PATH="${APPDIR}/usr/bin/LinguaNova:${LD_LIBRARY_PATH}"

# Qt plugin path
export QT_PLUGIN_PATH="${APPDIR}/usr/bin/LinguaNova/PyQt6/Qt6/plugins"

# QML import path
export QML2_IMPORT_PATH="${APPDIR}/usr/bin/LinguaNova/PyQt6/Qt6/qml"

# Bundled font support (emoji and system fonts)
if [ -d "${APPDIR}/usr/bin/LinguaNova/fonts" ]; then
    export FONTCONFIG_PATH="${APPDIR}/usr/bin/LinguaNova/fonts"
fi

# Launch the main binary
exec "${APPDIR}/usr/bin/LinguaNova/LinguaNova" "$@"